# ── Copier ce fichier en .env sur Railway et remplir les valeurs ──────────
# NE JAMAIS committer .env en Git !

# Django
SECRET_KEY=remplacer_par_une_cle_aleatoire_de_50_caracteres
DEBUG=False
ALLOWED_HOSTS=votre-app.railway.app,api.kovoit.com

# Base de données (Supabase → Connection string → URI)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe_supabase
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432

# Redis (Upstash → REST URL → utiliser redis:// URL)
REDIS_HOST=votre-instance.upstash.io
REDIS_PORT=6379
CHANNEL_LAYER_TYPE=redis
CELERY_BROKER_URL=rediss://default:votre_token@votre-instance.upstash.io:6379

# CORS (URL du frontend Vercel)
CORS_ALLOWED_ORIGINS=https://kovoit.vercel.app,https://kovoit.com

# Paiements PayPlus Africa
PAYPLUS_API_KEY=
PAYPLUS_TOKEN=
PAYPLUS_MERCHANT=
PAYPLUS_WEBHOOK_SECRET=
PAYPLUS_BASE_URL=https://app.payplus.africa
PAYPLUS_ENV=prod
PAYPLUS_NOTIFY_URL=https://votre-app.railway.app/api/paiements/webhook/

# Stockage Cloudflare R2
CF_R2_ACCOUNT_ID=votre_account_id
CF_R2_ACCESS_KEY=votre_access_key
CF_R2_SECRET_KEY=votre_secret_key
CF_R2_BUCKET=kovoit-media
CF_R2_PUBLIC_DOMAIN=media.kovoit.com

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre@gmail.com
EMAIL_HOST_PASSWORD=votre_app_password_gmail

# IA Chatbot
GROQ_API_KEY=
GEMINI_API_KEY_CHATBOT=
ANTHROPIC_API_KEY=

# SMS SOS
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# HTTPS (Railway gère le SSL automatiquement)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
