# ═══════════════════════════════════════════════════════════════
# CONFIGURATION PRODUCTION - À adapter pour votre serveur
# ⚠️ NE JAMAIS COMMITTER - Changer toutes les clés secrètes!
# ═══════════════════════════════════════════════════════════════

# ──── DJANGO CORE ────
SECRET_KEY=GENERATE-NEW-SECRET-KEY-HERE-with-django-insecure
DEBUG=False
ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com,api.votre-domaine.com
ENVIRONMENT=production

# ──── DATABASE ────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kovoit_prod
DB_USER=prod_user
DB_PASSWORD=CHANGE-ME-VERY-SECURE-PASSWORD
DB_HOST=prod-db-host.com
DB_PORT=5432

# ──── FRONTEND ────
FRONTEND_URL=https://votre-domaine.com
ADMIN_FRONTEND_URL=https://votre-domaine.com/admin/dashboard
CORS_ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# ──── PAYMENT GATEWAY ────
PAYGATE_API_KEY=PRODUCTION-API-KEY-FROM-PAYGATE
PAYGATE_MERCHANT_ID=PRODUCTION-MERCHANT-ID
PAYGATE_API_URL=https://api.paygate.cm

# ──── REDIS (Production) ────
REDIS_URL=redis://redis-prod:6379/0
CHANNEL_LAYER_TYPE=redis

# ──── SECURITY (PRODUCTION) ────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# ──── EMAIL (Production SMTP) ────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=PRODUCTION-SMTP-SERVER
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=PRODUCTION-EMAIL
EMAIL_HOST_PASSWORD=PRODUCTION-PASSWORD

# ──── LOGGING ────
LOG_LEVEL=INFO
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ──── CELERY ────
CELERY_BROKER_URL=redis://redis-prod:6379/1
CELERY_RESULT_BACKEND=redis://redis-prod:6379/2
