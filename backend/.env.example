# ═══════════════════════════════════════════════════════════════
# CONFIGURATION EXEMPLE - Copier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════════════════

# ──── DJANGO CORE ────
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
ENVIRONMENT=development

# ──── DATABASE ────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kovoit_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ──── FRONTEND ────
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3000/admin/dashboard
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ──── PAYMENT GATEWAY (PayGate) ────
PAYGATE_API_KEY=your-paygate-api-key
PAYGATE_MERCHANT_ID=your-merchant-id
PAYGATE_API_URL=https://api.paygate.cm
# Secret pour vérifier les webhooks entrants (doit correspondre au secret configuré dans PayGate)
PAYGATE_WEBHOOK_SECRET=your-paygate-webhook-secret

# ──── REDIS (WebSockets, Caching, Tasks) ────
REDIS_URL=redis://localhost:6379/0
CHANNEL_LAYER_TYPE=redis  # or inmemory for dev

# ──── SECURITY ────
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# ──── EMAIL (Notifications) ────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ──── LOGGING ────
LOG_LEVEL=DEBUG
SENTRY_DSN=

# ──── CELERY (Tasks Async) ────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ──── AFRICA'S TALKING (SMS SOS) ────
# Inscription gratuite sur https://africastalking.com
# Mode test : username=sandbox, clé depuis la console sandbox
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_USERNAME=sandbox
